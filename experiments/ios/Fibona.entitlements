<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The capabilities a free personal team can sign, except keychain sharing and app groups. Fixed at build time. -->
<plist version="1.0">
<dict>
	<!-- No app group: a personal team's profiles reject it. With a paid team, add
	     com.apple.security.application-groups = [group.$(APP_BUNDLE)] here and in widget/Widget.entitlements
	     so the widget can show what the app draws. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<key>com.apple.developer.homekit</key>
	<true/>
	<!-- Files can't be read while the phone is locked, including by background work. -->
	<key>com.apple.developer.default-data-protection</key>
	<string>NSFileProtectionComplete</string>
	<key>inter-app-audio</key>
	<true/>
	<key>com.apple.external-accessory.wireless-configuration</key>
	<true/>
</dict>
</plist>
